<?xml version="1.0" encoding="utf-8"?>
<RadioGroup xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/placement_radio_group"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <RadioButton
        android:id="@+id/placement_free"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/marshall_placement_free"
        android:padding="12dp" />

    <RadioButton
        android:id="@+id/placement_wall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/marshall_placement_wall"
        android:padding="12dp" />

    <RadioButton
        android:id="@+id/placement_edge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/marshall_placement_edge"
        android:padding="12dp" />

</RadioGroup>
